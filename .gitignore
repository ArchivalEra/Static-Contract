# ===== 白名单模式：默认忽略一切 =====
# 说明：/* 只作用于根目录每一项；目录被 ! 放行后，其内部默认全部跟踪
/*

# ===== 白名单（只有这些会被跟踪）=====
!.gitignore
!LICENSE
!NOTICE
!README.md
!STATE.md
!maintaince.md
!FACTS.json
!retractions.json
!/vendor/

# ===== Einfacht 事实系统（2026-11-01 接线，平台自 vendor/Einfacht 6e4e6e8）=====
!/zreflect/
!/reflect-hooks/

# ===== 契约正典与工具链（2026-11-01 自 extra-content 移交落库）=====
!/specs/
!/specs/*.md
# 中文原版归档（不发布到站点，只留可读历史）
!/specs/zh-archive/
!/specs/zh-archive/*.md
!/tools/
!/tools/*.py
!/questions/
!/questions/*.md
!/site/
!/site/*.json
# 构建产物只进 deploy 分支，不进 main
/site/dist/

# ===== 历史文档（2026-11-03）：事故编年史 / 裁定原文 =====
# 白名单模式下不显式放行就不进 git（同上踩过的坑）
!/docs/
!/docs/*.md
# 参考客户端（仓库内容，不进 dist —— H9 白名单仍恰好 7 个文件）
!/examples/
!/examples/*.py
!/examples/*.ts
!/examples/*.md
!/examples/*.json
# 离线测试（跑测试要 node_modules，那是本地产物，不进库）
!/examples/test/
!/examples/test/*.ts
/examples/node_modules/
/examples/package-lock.json

# ===== 部署自动更新链（2026-11-01）=====
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# 放行整个目录（含其下所有内容）时取消注释：
# !/src/
# 只放行目录内部分内容时：
# !/src/
# /src/*
# !/src/contracts/

# ===== mail/ + scripts/（2026-10-31 由 Octave-Extra-Content 建立）=====
# ⚠️ 白名单模式下新增目录必须放行，否则文件不进 git 且"看不见"（本集群踩过的坑）
!mail/
!mail/*.md
!mail/read/
!mail/read/*.md
!scripts/
!scripts/*.py

# 字节码缓存：白名单下 tools/*.py 的放行模式会被 *.pyc 绕过（实测踩过）
__pycache__/
*.pyc

# 派生 catalogue 的实时副本（CI 写，供闸门读；不进 git）
/site/catalogue.live.json
