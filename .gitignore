# ===== 白名单模式：默认忽略一切 =====
# 说明：/* 只作用于根目录每一项；目录被 ! 放行后，其内部默认全部跟踪
/*

# ===== 白名单（只有这些会被跟踪）=====
!.gitignore
!LICENSE
!README.md
!STATE.md
!maintaince.md
!FACTS.json
!retractions.json
!/vendor/

# ===== Einfacht 事实系统（2026-11-01 接线，平台自 vendor/Einfacht 6e4e6e8）=====
!/zreflect/
!/reflect-hooks/

# ===== 契约正典与工具链（2026-11-01 自 extra-content 移交落库）=====
!/specs/
!/specs/*.md
!/tools/
!/tools/*.py
!/questions/
!/questions/*.md
!/site/
!/site/*.json
# 构建产物只进 deploy 分支，不进 main
/site/dist/

# ===== 部署自动更新链（2026-11-01）=====
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# 放行整个目录（含其下所有内容）时取消注释：
# !/src/
# 只放行目录内部分内容时：
# !/src/
# /src/*
# !/src/contracts/

# ===== mail/ + scripts/（2026-10-31 由 Octave-Extra-Content 建立）=====
# ⚠️ 白名单模式下新增目录必须放行，否则文件不进 git 且"看不见"（本集群踩过的坑）
!mail/
!mail/*.md
!mail/read/
!mail/read/*.md
!scripts/
!scripts/*.py

# 字节码缓存：白名单下 tools/*.py 的放行模式会被 *.pyc 绕过（实测踩过）
__pycache__/
*.pyc
