# Einfacht.env —— Static-Contract 的钩子旋钮载体（形状见 Einfacht.env.example）。
# pre-commit / pre-push 在一切之前经 einfacht-env.sh 加载本文件；
# check_envfile.py 守它（typo / 文件旋钮指向缺失 / 空值 / sh 语法坏都报）。

# 语言包：新版本体零语言化（issue #26），输出走 M(code)；
# zh 包在 zreflect/lang/zh/（平台自带 + 本仓 4 个自有闸门的条目）
export REFLECT_LANG=zh

# 本仓数据层：量正典规模 / 三套自证 / catalogue / 邮件（换仓只改这一行）
export REFLECT_MEASURE_MODULE=measure_static_contract

# 台账与活状态（显式写出 —— 裸跑会用代码默认值，与钩子语境分叉）
export REFLECT_FACTS=FACTS.json
export REFLECT_DOC=STATE.md

# 活状态扫描面（本仓没有三语 README 与 AGENTS.md —— 按实有文件收窄）
export REFLECT_DOCS="STATE.md,README.md,maintaince.md"

# 三语同批闸门：本仓单语，单条目时互链判据自动成立，存在/非空/同批照常
export REFLECT_READMES="README.md"
